{
	"name": "sudoku",
	"version": "1.0.0",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "rollup -c --environment NODE_ENV:production",
		
		"predev": "rimraf dist",
		"dev": "rollup -c -w",
		"start": "sirv dist",
		"test": "vitest run",
		"test:contract": "vitest run tests/hw1/01-contract.test.js",
		"test:sudoku": "vitest run tests/hw1/02-sudoku-basic.test.js",
		"test:clone": "vitest run tests/hw1/03-clone.test.js",
		"test:game": "vitest run tests/hw1/04-game-undo-redo.test.js",
		"test:serialization": "vitest run tests/hw1/05-serialization.test.js",
		"test:roundtrip": "vitest run tests/hw1/06-round-trip.test.js"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^17.0.0",
		"@rollup/plugin-node-resolve": "^11.0.0",
		"autoprefixer": "^10.4.0",
		"cssnano": "^5.0.0",
		"postcss": "^8.4.0",
		"postcss-import": "^14.0.0",
		"rimraf": "^3.0.2",
		"rollup": "^2.3.4",
		"rollup-plugin-copy": "^3.3.0",
		"rollup-plugin-css-only": "^3.1.0",
		"rollup-plugin-livereload": "^2.0.0",
		"rollup-plugin-svelte": "^7.1.0",
		"rollup-plugin-terser": "^7.0.2",
		"svelte": "^3.49.0",
		"svelte-preprocess": "^4.10.7",
		"tailwindcss": "^3.3.0",
		"vitest": "^0.34.0"
	},
	"dependencies": {
		"@mattflow/sudoku-solver": "2.2.0",
		"fake-sudoku-puzzle-generator": "1.2.1",
		"sirv-cli": "1.0.0"
	}
}
